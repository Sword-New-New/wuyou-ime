<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- 顶部品牌区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="无忧输入法"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#12141A"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="智能不必上云，隐私无需妥协"
            android:textSize="13sp"
            android:textColor="#8A8F99"
            android:paddingTop="6dp"
            android:paddingBottom="22dp" />

        <!-- 使用引导：两步入网 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_banner"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始使用"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="两步即可启用，全程离线"
                android:textSize="12sp"
                android:textColor="#D9E4F2"
                android:paddingTop="4dp"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/btn_enable_ime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="第 1 步 · 启用无忧输入法"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2A4A6B"
                android:gravity="center"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:background="@drawable/bg_btn_primary" />

            <TextView
                android:id="@+id/btn_set_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="第 2 步 · 设为默认输入法"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_btn_outline" />
        </LinearLayout>

        <!-- 输入设置 -->
        <TextView style="@style/SectionTitle" android:text="输入设置" />

        <LinearLayout style="@style/Card">
            <LinearLayout style="@style/Row">
                <TextView style="@style/RowTitle" android:text="按键声音" />
                <Switch android:id="@+id/sw_sound" style="@style/RowSwitch" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout style="@style/Row">
                <TextView style="@style/RowTitle" android:text="振动反馈" />
                <Switch android:id="@+id/sw_vibrate" style="@style/RowSwitch" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中文输入 -->
        <TextView style="@style/SectionTitle" android:text="中文输入" />

        <LinearLayout style="@style/Card">
            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="模糊音" />
                    <TextView style="@style/RowSub" android:text="zh/z、n/l、an/ang 等不区分" />
                </LinearLayout>
                <Switch android:id="@+id/sw_fuzzy" style="@style/RowSwitch" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="智能纠错" />
                    <TextView style="@style/RowSub" android:text="少打字母也能出正确候选" />
                </LinearLayout>
                <Switch android:id="@+id/sw_correct" style="@style/RowSwitch" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="简拼输入" />
                    <TextView style="@style/RowSub" android:text="输入首字母快速选词" />
                </LinearLayout>
                <Switch android:id="@+id/sw_simplified" style="@style/RowSwitch" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout style="@style/Row">
                <TextView style="@style/RowTitle" android:text="词语联想" />
                <Switch android:id="@+id/sw_associate" style="@style/RowSwitch" />
            </LinearLayout>
        </LinearLayout>

        <!-- 智能输入 -->
        <TextView style="@style/SectionTitle" android:text="智能输入" />

        <LinearLayout style="@style/Card">
            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="个性化学习" />
                    <TextView style="@style/RowSub" android:text="只在本机记录你的用词习惯" />
                </LinearLayout>
                <Switch android:id="@+id/sw_personalize" style="@style/RowSwitch" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout style="@style/Row">
                <TextView style="@style/RowTitle" android:text="上下文预测" />
                <Switch android:id="@+id/sw_context" style="@style/RowSwitch" />
            </LinearLayout>
        </LinearLayout>

        <!-- 隐私与安全 -->
        <TextView style="@style/SectionTitle" android:text="隐私与安全" />

        <LinearLayout style="@style/Card">
            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="隐私模式" />
                    <TextView style="@style/RowSub" android:text="开启后不学习任何输入内容" />
                </LinearLayout>
                <Switch android:id="@+id/sw_privacy" style="@style/RowSwitch" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout style="@style/Row">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="剪贴板历史" />
                    <TextView style="@style/RowSub" android:text="默认关闭，仅前台读取" />
                </LinearLayout>
                <Switch android:id="@+id/sw_clipboard" style="@style/RowSwitch" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_clear_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清除个人学习数据"
            android:textSize="14sp"
            android:textColor="#C0392B"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card" />

        <!-- 更多 -->
        <TextView style="@style/SectionTitle" android:text="更多" />

        <LinearLayout style="@style/Card">
            <LinearLayout android:id="@+id/btn_dict" style="@style/RowClickable">
                <TextView style="@style/RowTitle" android:text="词库管理" />
                <TextView style="@style/RowArrow" android:text="›" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout android:id="@+id/btn_theme" style="@style/RowClickable">
                <TextView style="@style/RowTitle" android:text="外观主题" />
                <TextView style="@style/RowArrow" android:text="›" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout android:id="@+id/btn_privacy" style="@style/RowClickable">
                <TextView style="@style/RowTitle" android:text="隐私保护说明" />
                <TextView style="@style/RowArrow" android:text="›" />
            </LinearLayout>
            <View style="@style/Divider" />
            <LinearLayout android:id="@+id/btn_official" style="@style/RowClickable">
                <LinearLayout style="@style/RowText">
                    <TextView style="@style/RowTitle" android:text="官方网站" />
                    <TextView style="@style/RowSub" android:text="wuyouai.gemigo.app" />
                </LinearLayout>
                <TextView style="@style/RowArrow" android:text="›" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="V2.0 · 无网络权限 · 无第三方 SDK"
            android:textSize="11sp"
            android:textColor="#A8ADB7"
            android:gravity="center"
            android:paddingTop="22dp" />
    </LinearLayout>
</ScrollView>
