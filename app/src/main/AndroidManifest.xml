<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      无忧输入法 V2.0 —— 隐私优先
      刻意不声明 INTERNET 权限：应用无法联网，从系统层面保证数据不出设备。
      未申请：INTERNET / ACCESS_NETWORK_STATE / READ_CLIPBOARD(后台) / 无障碍 等。
      唯一使用的系统级声明是 android.permission.VIBRATE（按键振动反馈）。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Android 11+ 包可见性：仅声明「需要能打开网页」以便跳转官网。
      这里不授予任何权限，应用的官网入口交给系统浏览器处理，本应用自身不联网。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".WuyouApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wuyou"
        tools:targetApi="34">

        <!-- 系统输入法服务（核心） -->
        <service
            android:name=".keyboard.WuyouInputMethodService"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- 设置中心 -->
        <activity
            android:name=".settings.SettingsActivity"
            android:label="@string/settings_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 词库管理 -->

        <!-- 首次启动引导（6 页） -->
        <activity
            android:name=".welcome.WelcomeActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:theme="@style/Theme.Wuyou" />

        <!-- 协议全文查看 -->
        <activity
            android:name=".welcome.DocActivity"
            android:label="@string/privacy_title"
            android:exported="false"
            android:theme="@style/Theme.Wuyou" />
        <activity
            android:name=".settings.DictionaryActivity"
            android:label="@string/dict_title"
            android:exported="false" />

        <!-- 主题设置 -->
        <activity
            android:name=".settings.ThemeActivity"
            android:label="@string/theme_title"
            android:exported="false" />

        <!-- 隐私说明 -->
        <activity
            android:name=".privacy.PrivacyActivity"
            android:label="@string/privacy_title"
            android:exported="false" />
    </application>
</manifest>
